-- AUXILIA - Sistema de gestion y distribucion equitativa de ayudas en emergencias
-- SCRIPT 1 de 2: OBJETOS (borrado, tablas, comentarios, restricciones, secuencias y triggers)
-- Motor: Oracle (APEX > SQL Workshop > SQL Scripts). Ejecutar completo, de una sola vez.
-- ============================================================================

-- ============================================================================
-- Borrado de objetos (si no existen no se genera error)
-- ============================================================================
DECLARE
  TYPE t_lista IS TABLE OF VARCHAR2(40);
  v_vistas t_lista := t_lista('V_ALBERGUES','V_OCUPACION_ALBERGUES','V_SEMAFORO_VENCIMIENTOS','V_DESPACHOS_DETALLE','V_PRORRATEO_SOLICITUDES');
  v_tablas t_lista := t_lista('DETALLE_DESPACHO','DESPACHO','VEHICULO','DETALLE_SOLICITUD','SOLICITUD_AYUDA','INVENTARIO_LOTE','PRODUCTO','REGISTRO_CENSO','DAMNIFICADO','CENSO','ASIGNACION_CUADRILLA','ALBERGUE_ACOPIO','CUADRILLA_SOCORRO','PERSONAL_SOCORRO','INSTITUCION','ZONA_AFECTADA');
  v_secs   t_lista := t_lista('ZONA_AFECTADA_SEQ','INSTITUCION_SEQ','PERSONAL_SOCORRO_SEQ','CUADRILLA_SOCORRO_SEQ','ALBERGUE_ACOPIO_SEQ','ASIGNACION_CUADRILLA_SEQ','CENSO_SEQ','DAMNIFICADO_SEQ','REGISTRO_CENSO_SEQ','PRODUCTO_SEQ','INVENTARIO_LOTE_SEQ','SOLICITUD_AYUDA_SEQ','DETALLE_SOLICITUD_SEQ','VEHICULO_SEQ','DESPACHO_SEQ','DETALLE_DESPACHO_SEQ');
BEGIN
  FOR i IN 1 .. v_vistas.COUNT LOOP
    BEGIN EXECUTE IMMEDIATE 'DROP VIEW ' || v_vistas(i);
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;
  END LOOP;
  FOR i IN 1 .. v_tablas.COUNT LOOP
    BEGIN EXECUTE IMMEDIATE 'DROP TABLE ' || v_tablas(i);
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;
  END LOOP;
  FOR i IN 1 .. v_secs.COUNT LOOP
    BEGIN EXECUTE IMMEDIATE 'DROP SEQUENCE ' || v_secs(i);
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -2289 THEN RAISE; END IF; END;
  END LOOP;
END;
/

-- ============================================================================
-- Creacion tabla de ZONA_AFECTADA
-- ============================================================================
CREATE TABLE ZONA_AFECTADA
(cod_zona                 VARCHAR2(5) NOT NULL,
  cod_zona_padre           VARCHAR2(5),
  nombre                   VARCHAR2(60) NOT NULL,
  tipo                     VARCHAR2(12) NOT NULL,
  nivel_dano               VARCHAR2(8) NOT NULL,
  habitantes_riesgo        NUMBER(9) NOT NULL,
  pct_infra_comprometida   NUMBER(5,2) NOT NULL,
  falla_total_servicios    CHAR(1) NOT NULL,
  latitud                  NUMBER(9,6) NOT NULL,
  longitud                 NUMBER(9,6) NOT NULL
);

COMMENT ON TABLE ZONA_AFECTADA IS 'Maestro de ZONAS afectadas (jerarquia recursiva).';
COMMENT ON COLUMN ZONA_AFECTADA.cod_zona IS 'Codigo de la ZONA.';
COMMENT ON COLUMN ZONA_AFECTADA.cod_zona_padre IS 'Zona de la que depende (departamento > municipio > comuna/vereda).';
COMMENT ON COLUMN ZONA_AFECTADA.nombre IS 'Nombre de la ZONA.';
COMMENT ON COLUMN ZONA_AFECTADA.tipo IS 'Tipo: DEPARTAMENTO, MUNICIPIO, COMUNA o VEREDA.';
COMMENT ON COLUMN ZONA_AFECTADA.nivel_dano IS 'Nivel de dano: LEVE, MODERADO, GRAVE o CRITICO.';
COMMENT ON COLUMN ZONA_AFECTADA.habitantes_riesgo IS 'Habitantes en riesgo (base del prorrateo equitativo).';
COMMENT ON COLUMN ZONA_AFECTADA.pct_infra_comprometida IS 'Porcentaje de infraestructura comprometida.';
COMMENT ON COLUMN ZONA_AFECTADA.falla_total_servicios IS 'S si hay falla total de agua y energia, N si no.';
COMMENT ON COLUMN ZONA_AFECTADA.latitud IS 'Latitud de la zona.';
COMMENT ON COLUMN ZONA_AFECTADA.longitud IS 'Longitud de la zona.';

ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT PK_ZONA_AFECTADA PRIMARY KEY (cod_zona);
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT UK_ZON_NOMBRE UNIQUE (nombre);
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT CK_ZON_TIPO CHECK (tipo IN ('DEPARTAMENTO','MUNICIPIO','COMUNA','VEREDA'));
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT CK_ZON_NIVEL CHECK (nivel_dano IN ('LEVE','MODERADO','GRAVE','CRITICO'));
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT CK_ZON_FALLA CHECK (falla_total_servicios IN ('S','N'));
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT CK_ZON_PCT CHECK (pct_infra_comprometida BETWEEN 0 AND 100);
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT CK_ZON_HAB CHECK (habitantes_riesgo >= 0);
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT CK_ZON_CRITICO CHECK (nivel_dano <> 'CRITICO' OR pct_infra_comprometida > 40 OR falla_total_servicios = 'S');
ALTER TABLE ZONA_AFECTADA ADD CONSTRAINT FK_ZON_PADRE FOREIGN KEY (cod_zona_padre) REFERENCES ZONA_AFECTADA (cod_zona);


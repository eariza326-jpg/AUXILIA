-- ============================================================================
-- REGLAS DE NEGOCIO (triggers)
-- ============================================================================
-- RN1: producto perecedero debe tener vencimiento y al menos 30 dias desde el ingreso al inventario
CREATE OR REPLACE TRIGGER TRG_LOTE_PERECEDERO
BEFORE INSERT ON INVENTARIO_LOTE
FOR EACH ROW
DECLARE
  v_perecedero PRODUCTO.perecedero%TYPE;
BEGIN
  SELECT pro.perecedero INTO v_perecedero
  FROM PRODUCTO pro
  WHERE pro.cod_producto = :NEW.cod_producto;
  IF v_perecedero = 'S' THEN
    IF :NEW.fecha_vencimiento IS NULL THEN
      RAISE_APPLICATION_ERROR(-20001, 'Un producto perecedero requiere fecha de vencimiento.');
    END IF;
    IF :NEW.fecha_vencimiento < :NEW.fecha_ingreso + 30 THEN
      RAISE_APPLICATION_ERROR(-20002, 'El producto perecedero debe vencer al menos 30 dias despues de su ingreso.');
    END IF;
  END IF;
END TRG_LOTE_PERECEDERO;
/

-- RN2: un albergue no puede superar el 100% de su capacidad
CREATE OR REPLACE TRIGGER TRG_REGISTRO_CAPACIDAD
BEFORE INSERT ON REGISTRO_CENSO
FOR EACH ROW
DECLARE
  v_albergue ALBERGUE_ACOPIO.cod_albergue%TYPE;
  v_capacidad ALBERGUE_ACOPIO.capacidad_max%TYPE;
  v_ocupados NUMBER;
BEGIN
  IF :NEW.estado = 'ACTIVO' THEN
    SELECT cen.cod_albergue INTO v_albergue
    FROM CENSO cen
    WHERE cen.cod_censo = :NEW.cod_censo;
    IF v_albergue IS NOT NULL THEN
      SELECT alb.capacidad_max INTO v_capacidad
      FROM ALBERGUE_ACOPIO alb
      WHERE alb.cod_albergue = v_albergue;
      SELECT COUNT(*) INTO v_ocupados
      FROM REGISTRO_CENSO reg, CENSO cen2
      WHERE reg.cod_censo = cen2.cod_censo
      AND cen2.cod_albergue = v_albergue
      AND reg.estado = 'ACTIVO';
      IF v_ocupados >= v_capacidad THEN
        RAISE_APPLICATION_ERROR(-20003, 'El albergue ya alcanzo el 100% de su capacidad.');
      END IF;
    END IF;
  END IF;
END TRG_REGISTRO_CAPACIDAD;
/

-- RN3: un integrante no puede tener dos asignaciones cuyas fechas se crucen
CREATE OR REPLACE TRIGGER TRG_ASIGNACION_SOLAPE
BEFORE INSERT ON ASIGNACION_CUADRILLA
FOR EACH ROW
DECLARE
  v_cruces NUMBER;
BEGIN
  IF :NEW.estado <> 'CANCELADA' THEN
    SELECT COUNT(*) INTO v_cruces
    FROM ASIGNACION_CUADRILLA asi
    WHERE asi.cod_personal = :NEW.cod_personal
    AND asi.estado <> 'CANCELADA'
    AND asi.fecha_inicio <= NVL(:NEW.fecha_fin, DATE '9999-12-31')
    AND NVL(asi.fecha_fin, DATE '9999-12-31') >= :NEW.fecha_inicio;
    IF v_cruces > 0 THEN
      RAISE_APPLICATION_ERROR(-20004, 'El integrante ya tiene una asignacion que se cruza con estas fechas.');
    END IF;
  END IF;
END TRG_ASIGNACION_SOLAPE;
/

-- RN4: un despacho no puede superar las existencias del lote; descuenta el stock en la misma transaccion
CREATE OR REPLACE TRIGGER TRG_DETDESP_STOCK
BEFORE INSERT ON DETALLE_DESPACHO
FOR EACH ROW
DECLARE
  v_existencias  INVENTARIO_LOTE.existencias%TYPE;
  v_vencimiento  INVENTARIO_LOTE.fecha_vencimiento%TYPE;
  v_alb_lote     INVENTARIO_LOTE.cod_albergue%TYPE;
  v_prod_lote    INVENTARIO_LOTE.cod_producto%TYPE;
  v_alb_origen   DESPACHO.cod_albergue_origen%TYPE;
  v_sol_despacho DESPACHO.cod_solicitud%TYPE;
  v_prod_det     DETALLE_SOLICITUD.cod_producto%TYPE;
  v_sol_det      DETALLE_SOLICITUD.cod_solicitud%TYPE;
BEGIN
  SELECT lot.existencias, lot.fecha_vencimiento, lot.cod_albergue, lot.cod_producto
  INTO v_existencias, v_vencimiento, v_alb_lote, v_prod_lote
  FROM INVENTARIO_LOTE lot
  WHERE lot.cod_lote = :NEW.cod_lote
  FOR UPDATE;

  SELECT des.cod_albergue_origen, des.cod_solicitud
  INTO v_alb_origen, v_sol_despacho
  FROM DESPACHO des
  WHERE des.cod_despacho = :NEW.cod_despacho;

  SELECT dso.cod_producto, dso.cod_solicitud
  INTO v_prod_det, v_sol_det
  FROM DETALLE_SOLICITUD dso
  WHERE dso.cod_detalle = :NEW.cod_detalle;

  IF v_alb_lote <> v_alb_origen THEN
    RAISE_APPLICATION_ERROR(-20005, 'El lote no esta almacenado en el sitio de origen del despacho.');
  END IF;
  IF v_prod_lote <> v_prod_det OR v_sol_det <> v_sol_despacho THEN
    RAISE_APPLICATION_ERROR(-20006, 'El lote o el detalle no corresponden a la solicitud del despacho.');
  END IF;
  IF v_vencimiento IS NOT NULL AND v_vencimiento < TRUNC(SYSDATE) THEN
    RAISE_APPLICATION_ERROR(-20007, 'No se puede despachar un lote vencido.');
  END IF;
  IF :NEW.cantidad > v_existencias THEN
    RAISE_APPLICATION_ERROR(-20008, 'La cantidad despachada supera las existencias del lote.');
  END IF;

  UPDATE INVENTARIO_LOTE
  SET existencias = existencias - :NEW.cantidad
  WHERE cod_lote = :NEW.cod_lote;
END TRG_DETDESP_STOCK;
/


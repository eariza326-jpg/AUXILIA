-- ============================================================================
-- CONSULTAS (vistas). Sin JOIN: las tablas se relacionan en el WHERE. Sin SELECT *.
-- ============================================================================

-- Consulta 1: Albergues y centros de acopio con su zona, nivel de dano y coordinador
CREATE OR REPLACE VIEW V_ALBERGUES AS
SELECT alb.cod_albergue, alb.nombre AS albergue, alb.tipo, zon.nombre AS zona, zon.nivel_dano,
       per.nombres || ' ' || per.apellidos AS coordinador, alb.capacidad_max, alb.estado
FROM ALBERGUE_ACOPIO alb, ZONA_AFECTADA zon, PERSONAL_SOCORRO per
WHERE alb.cod_zona = zon.cod_zona
AND alb.cod_coordinador = per.cod_personal
ORDER BY zon.nombre, alb.nombre;

-- Consulta 2: Ocupacion de cada albergue (personas con registro activo frente a su capacidad)
CREATE OR REPLACE VIEW V_OCUPACION_ALBERGUES AS
SELECT alb.cod_albergue, alb.nombre AS albergue, alb.capacidad_max,
       COUNT(reg.cod_registro) AS personas_alojadas,
       ROUND(COUNT(reg.cod_registro) * 100 / alb.capacidad_max, 2) AS pct_ocupacion
FROM ALBERGUE_ACOPIO alb, CENSO cen, REGISTRO_CENSO reg
WHERE cen.cod_albergue = alb.cod_albergue
AND reg.cod_censo = cen.cod_censo
AND reg.estado = 'ACTIVO'
AND alb.tipo = 'ALBERGUE'
GROUP BY alb.cod_albergue, alb.nombre, alb.capacidad_max
ORDER BY pct_ocupacion DESC;

-- Consulta 3: Semaforo de vencimientos (primero los lotes que vencen antes: criterio FEFO)
CREATE OR REPLACE VIEW V_SEMAFORO_VENCIMIENTOS AS
SELECT lot.cod_lote, pro.nombre AS producto, alb.nombre AS sitio, lot.numero_lote, lot.existencias,
       lot.fecha_vencimiento,
       TRUNC(lot.fecha_vencimiento) - TRUNC(SYSDATE) AS dias_para_vencer,
       CASE WHEN TRUNC(lot.fecha_vencimiento) - TRUNC(SYSDATE) < 0 THEN 'VENCIDO'
            WHEN TRUNC(lot.fecha_vencimiento) - TRUNC(SYSDATE) <= 30 THEN 'ROJO'
            WHEN TRUNC(lot.fecha_vencimiento) - TRUNC(SYSDATE) <= 90 THEN 'AMARILLO'
            ELSE 'VERDE' END AS semaforo
FROM INVENTARIO_LOTE lot, PRODUCTO pro, ALBERGUE_ACOPIO alb
WHERE lot.cod_producto = pro.cod_producto
AND lot.cod_albergue = alb.cod_albergue
AND lot.fecha_vencimiento IS NOT NULL
AND lot.existencias > 0
ORDER BY lot.fecha_vencimiento, lot.cod_lote;

-- Consulta 4: Detalle de despachos con zona destino, producto, lote, vehiculo y conductor
CREATE OR REPLACE VIEW V_DESPACHOS_DETALLE AS
SELECT des.cod_despacho, des.estado, sol.cod_solicitud, zon.nombre AS zona_destino, pro.nombre AS producto,
       lot.numero_lote, dde.cantidad, veh.placa,
       per.nombres || ' ' || per.apellidos AS conductor, des.fecha_creacion
FROM DESPACHO des, DETALLE_DESPACHO dde, DETALLE_SOLICITUD dso, SOLICITUD_AYUDA sol,
     ZONA_AFECTADA zon, PRODUCTO pro, INVENTARIO_LOTE lot, VEHICULO veh, PERSONAL_SOCORRO per
WHERE dde.cod_despacho = des.cod_despacho
AND dde.cod_detalle = dso.cod_detalle
AND dde.cod_lote = lot.cod_lote
AND des.cod_solicitud = sol.cod_solicitud
AND sol.cod_zona = zon.cod_zona
AND dso.cod_producto = pro.cod_producto
AND des.cod_vehiculo = veh.cod_vehiculo
AND des.cod_conductor = per.cod_personal
ORDER BY des.cod_despacho, pro.nombre;

-- Consulta 5: Prorrateo equitativo. Reparte las existencias de cada producto entre las zonas con
-- solicitudes abiertas, en proporcion a sus habitantes en riesgo (sin pasar de lo que falta por entregar)
CREATE OR REPLACE VIEW V_PRORRATEO_SOLICITUDES AS
SELECT sol.cod_solicitud, zon.nombre AS zona, zon.habitantes_riesgo, pro.nombre AS producto,
       dso.cantidad_solicitada, dso.cantidad_asignada,
       (SELECT NVL(SUM(lo1.existencias), 0) FROM INVENTARIO_LOTE lo1
         WHERE lo1.cod_producto = dso.cod_producto) AS existencias_totales,
       ROUND(zon.habitantes_riesgo * 100 /
         (SELECT SUM(zo2.habitantes_riesgo)
            FROM DETALLE_SOLICITUD ds2, SOLICITUD_AYUDA so2, ZONA_AFECTADA zo2
           WHERE ds2.cod_solicitud = so2.cod_solicitud
             AND so2.cod_zona = zo2.cod_zona
             AND ds2.cod_producto = dso.cod_producto
             AND so2.estado IN ('PENDIENTE', 'EN_PROCESO')), 2) AS pct_equitativo,
       LEAST(dso.cantidad_solicitada - dso.cantidad_asignada,
         ROUND((SELECT NVL(SUM(lo3.existencias), 0) FROM INVENTARIO_LOTE lo3
                 WHERE lo3.cod_producto = dso.cod_producto) * zon.habitantes_riesgo /
         (SELECT SUM(zo4.habitantes_riesgo)
            FROM DETALLE_SOLICITUD ds4, SOLICITUD_AYUDA so4, ZONA_AFECTADA zo4
           WHERE ds4.cod_solicitud = so4.cod_solicitud
             AND so4.cod_zona = zo4.cod_zona
             AND ds4.cod_producto = dso.cod_producto
             AND so4.estado IN ('PENDIENTE', 'EN_PROCESO')), 2)) AS cantidad_sugerida
FROM DETALLE_SOLICITUD dso, SOLICITUD_AYUDA sol, ZONA_AFECTADA zon, PRODUCTO pro
WHERE dso.cod_solicitud = sol.cod_solicitud
AND sol.cod_zona = zon.cod_zona
AND dso.cod_producto = pro.cod_producto
AND sol.estado IN ('PENDIENTE', 'EN_PROCESO')
ORDER BY pro.nombre, sol.cod_solicitud;

-- ============================================================================
-- Ejecucion de las consultas (columnas explicitas, para las capturas de pantalla)
-- ============================================================================

SELECT cod_albergue, albergue, tipo, zona, nivel_dano, coordinador, capacidad_max, estado
FROM V_ALBERGUES;

SELECT cod_albergue, albergue, capacidad_max, personas_alojadas, pct_ocupacion
FROM V_OCUPACION_ALBERGUES;

SELECT cod_lote, producto, sitio, numero_lote, existencias, fecha_vencimiento, dias_para_vencer, semaforo
FROM V_SEMAFORO_VENCIMIENTOS;

SELECT cod_despacho, estado, cod_solicitud, zona_destino, producto, numero_lote, cantidad, placa, conductor
FROM V_DESPACHOS_DETALLE;

SELECT cod_solicitud, zona, habitantes_riesgo, producto, cantidad_solicitada, cantidad_asignada,
       existencias_totales, pct_equitativo, cantidad_sugerida
FROM V_PRORRATEO_SOLICITUDES;
